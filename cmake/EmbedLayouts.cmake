# Writes the C++ source holding the screen layouts. Run at build time:
#   cmake -DOUTPUT=<file.cpp> -DLIST=<file with one xml path per line> -P EmbedLayouts.cmake
# Each file becomes an unsigned char array (a string literal could hit the compiler's length
# limit), and a table maps the bare file name to it.
file(STRINGS "${LIST}" paths)
set(arrays "")
set(table "")
set(index 0)
foreach(path ${paths})
  get_filename_component(name "${path}" NAME)
  file(READ "${path}" hex HEX)
  string(LENGTH "${hex}" hexLength)
  math(EXPR size "${hexLength} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(APPEND arrays "static const unsigned char layout${index}[] = {${bytes}0};\n")
  string(APPEND table "    {\"${name}\", layout${index}, ${size}},\n")
  math(EXPR index "${index} + 1")
endforeach()
file(WRITE "${OUTPUT}.tmp" "// Generated by cmake/EmbedLayouts.cmake from src/client/views; do not edit.
#include \"client/services/EmbeddedLayouts.h\"

#include <cstddef>

namespace client {

namespace {

struct Entry {
    const char* name;
    const unsigned char* data;
    std::size_t size;
};

${arrays}
const Entry layouts[] = {
${table}};

} // namespace

std::optional<std::string> embeddedLayout(const std::string& fileName) {
    for (const Entry& entry : layouts) {
        if (fileName == entry.name) {
            return std::string(reinterpret_cast<const char*>(entry.data), entry.size);
        }
    }
    return std::nullopt;
}

} // namespace client
")
# keep the old file (and so the timestamp) when nothing changed
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUTPUT}.tmp" "${OUTPUT}")
file(REMOVE "${OUTPUT}.tmp")
