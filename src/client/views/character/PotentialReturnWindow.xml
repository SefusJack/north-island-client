<?xml version="1.0" encoding="utf-8"?>
<!-- The Potential Return form (TPotentialReturnForm, the Anti-Potential Pill 34351); view model: viewmodels/PotentialReturnWindow.cpp.  The pets
     that are no soldiers in rows, the one chosen shown with the wheel of its potential and its abilities with what the pill takes off; OK asks
     and uses the pill on it.  The game draws a form's controls from the last created to the first: the controls here are in drawing order, the
     reverse of TPotentialReturnForm.Create. -->
<Panel Name="PotentialReturnLayer" Bounds="0,0,800,600">
  <Window Name="PotentialReturn" Escape="onPotentialReturnClose" Picture="Form_Potential_2" Position="250,70" Visible="false">
    <IconGrid Name="PotentialReturnItem" Position="74,328" Columns="1" Rows="1" Pitch="30" CellSize="30" HoverColor="#00000000"/>
    <BlockList Name="PotentialReturnTargets" Bounds="32,79,233,168" RowHeight="33" RowSpacing="1" HighlightColor="#89BEF5" HoverAlpha="80"
               SelectionAlpha="120" Click="onPotentialReturnTarget"/>
    <!-- the rows' TRe_MiniPetInfo -->
    <DrawingArea Name="PotentialReturnFigures" Bounds="0,0,299,460"/>
    <ImageButton Name="PotentialReturnOk" Picture="btn_ok_1" Position="87,414" Click="onPotentialReturnOk"/>
    <ImageButton Name="PotentialReturnCancel" Picture="Btn_Cancel_1" Position="163,414" Hint="[ESC]" Click="onPotentialReturnClose"
                 ClickSound="" ReleaseSound="sound/wav0154.wav"/>
    <ImageButton Name="PotentialReturnCloseSmall" Picture="Btn_Close_s_1" Position="249,26" Hint="[ESC]" Click="onPotentialReturnClose"
                 ClickSound="" ReleaseSound="sound/wav0154.wav"/>
    <!-- RenderWithChildren, after the controls: the rows' texts, the figure, the wheel and the abilities -->
    <DrawingArea Name="PotentialReturnPaint" Bounds="0,0,299,460">
      <!-- the first pet row: top-left, and the step down to the next row -->
      <Spot Name="PotentialReturnRows" Position="32,78" Pitch="0,34"/>
      <!-- the pet name inside a row: offset from the row -->
      <Spot Name="PotentialReturnRowName" Position="38,8"/>
      <!-- the text colour, near-black (RGB565 2113), the potential count's colour, red (RGB565 63488), and the taken amount's colour, blue (RGB565 31) -->
      <Spot Name="PotentialReturnTextColor" Color="#080808"/>
      <Spot Name="PotentialReturnHaveColor" Color="#FF0000"/>
      <Spot Name="PotentialReturnTakenColor" Color="#0000FF"/>
      <!-- the pet preview's feet -->
      <Spot Name="PotentialReturnPreviewFeet" Position="199,311"/>
    </DrawingArea>
  </Window>
</Panel>
