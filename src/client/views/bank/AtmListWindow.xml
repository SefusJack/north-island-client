<?xml version="1.0" encoding="utf-8"?>
<!-- The ATM's list of players (TATMSubForm, the List button of the transfer form): the friends and the guild members (the two ticks filter them); a double
     click on a row puts the name in the transfer form if that player is online.  View model: viewmodels/AtmListWindow.cpp.  The game draws a form's
     controls from the last created to the first: the controls here are in drawing order, the reverse of TATMSubForm.Create. -->
<Panel Name="AtmListLayer" Bounds="0,0,800,600">
  <Window Name="AtmList" AbovePopups="true" Escape="onAtmListClose" Picture="Form_ATM_List" Position="286,139" Size="228,321" Visible="false">
    <ImageButton Name="AtmListDown" Picture="Btn_ArrowDn_1" Position="190,264" Size="17,17" Click="onAtmListDown"/>
    <ImageButton Name="AtmListUp" Picture="Btn_ArrowUp_1" Position="190,68" Size="17,17" Click="onAtmListUp"/>
    <ImageButton Name="AtmListCloseSmall" Picture="Btn_Close_s_1" Position="178,26" Size="18,18" Hint="[ESC]" Click="onAtmListClose"
                 ClickSound="" ReleaseSound="sound/wav0154.wav"/>
    <ListBox Name="AtmListNames" Bounds="22,72,163,210" RowHeight="26" FontColor="#FFFFFF" HighlightColor="#89BFF5" FocusFrame="false" TextShadow="false"
             TextOffset="10,3" ScrollBar="AtmListScroll" DoubleClick="onAtmListPick"/>
    <ScrollBar Name="AtmListScroll" Bounds="190,85,17,179" Track="Rail_H5" TrackCap="16" Thumb="bar_H4" ThumbSource="0,0,9,21" ThumbCap="7" ThumbInset="3"/>
    <CheckBox Name="AtmListGuild" Picture="btn_UnCheck_1" CheckedPicture="btn_Check_1" Checked="true" Position="74,46" Size="16,16" Click="onAtmListFilter"/>
    <CheckBox Name="AtmListFriends" Picture="btn_UnCheck_1" CheckedPicture="btn_Check_1" Checked="true" Position="18,46" Size="16,16" Click="onAtmListFilter"/>
  </Window>
</Panel>
