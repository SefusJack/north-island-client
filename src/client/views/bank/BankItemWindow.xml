<?xml version="1.0" encoding="utf-8"?>
<!-- The bank's items (TTH_BankItemForm, 29/6); view model: viewmodels/BankItemWindow.cpp.
     The bank on the left, the bag on the right: a click marks an item (the right button
     unmarks it); the left arrow puts the bag's marked items in (30/2), the right one takes the
     bank's out (30/1).  An item dragged between the grids moves too (30/3 within the bank, 30/4 in, 30/5 out).  Closing lets the event go on.  The game draws a form's controls from
     the last created to the first: the controls here are in drawing order, the reverse of
     TTH_BankItemForm.Create (the bag grid comes first, from TRe_ItemGridForm). -->
<Panel Name="BankItemLayer" Bounds="0,0,800,600">
  <Window Name="BankItem" Escape="onBankItemClose" Picture="Form_itemBank_1" Position="189,59" Visible="false">
    <ImageButton Name="BankItemSort" Picture="Btn_Module_2" Position="96,56" Size="32,20" Narrow="true" IconLines="3,0 3,11; 0,3 3,0 6,3; 10,0 10,11; 7,8 10,11 13,8" IconWidth="2" Hint="Sort (qol)" Visible="false" Click="onBankItemSort"/>
    <ImageButton Name="BankItemClose" Picture="Btn_Close_1" Position="179,437" Click="onBankItemClose"/>
    <ImageButton Name="BankItemCloseSmall" Picture="Btn_Close_s_1" Position="365,25" Size="18,18" Click="onBankItemClose"/>
    <ImageButton Name="BankItemWithdraw" Picture="Btn_ArrowR_5" Position="200,200" Size="17,17" Click="onBankItemWithdraw"/>
    <ImageButton Name="BankItemStore" Picture="Btn_ArrowL_5" Position="199,247" Size="17,17" Click="onBankItemStore"/>
    <IconGrid Name="BankItemBank" Position="20,83" Columns="5" Rows="10" Pitch="34" Draggable="true" Press="onBankItemPress" Click="onBankItemBankClick"
              RightClick="onBankItemBankUnmark" Drop="onBankItemBankDrop"/>
    <IconGrid Name="BankItemBag" Position="224,83" Columns="5" Rows="10" Pitch="34" Draggable="true" Press="onBankItemPress" Click="onBankItemBagClick"
              RightClick="onBankItemBagUnmark" Drop="onBankItemBagDrop"/>
  </Window>
</Panel>
