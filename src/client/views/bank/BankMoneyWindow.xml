<?xml version="1.0" encoding="utf-8"?>
<!-- The bank's money account (TMoneyAccountForm, 29/5); view model:
     viewmodels/BankMoneyWindow.cpp.  The gold in the account and the gold carried; how much
     to take out (left, the right arrow: 29/1) or put in (right, the left arrow: 29/2).
     Closing lets the event go on.  The game draws a form's controls from the last created to
     the first: the controls here are in drawing order, the reverse of TMoneyAccountForm.Create
     (its hidden up / down arrows are left out). -->
<Panel Name="BankMoneyLayer" Bounds="0,0,800,600">
  <Window Name="BankMoney" Picture="Form_BankMoney_1" Position="207,195" Visible="false">
    <!-- DrawControl: the two amounts of gold -->
    <DrawingArea Name="BankMoneyPaint" Bounds="0,0,385,210">
      <!-- the colour of the two amounts of gold (RGB565 2113) -->
      <Spot Name="BankMoneyText" Color="#080808"/>
    </DrawingArea>
    <ImageButton Name="BankMoneyCloseSmall" Picture="Btn_Close_s_1" Position="334,24" Size="17,17" Click="onBankMoneyClose"
                 ClickSound="" ReleaseSound="sound/wav0154.wav"/>
    <ImageButton Name="BankMoneyClose" Picture="Btn_Close_1" Position="165,143" Click="onBankMoneyClose"
                 ClickSound="" ReleaseSound="sound/wav0154.wav"/>
    <ImageButton Name="BankMoneyDeposit" Picture="Btn_ArrowL_5" Position="185,62" Size="17,17" Hint="Deposit"
                 Click="onBankMoneyDeposit"/>
    <TextBox Name="BankMoneyDepositAmount" Bounds="270,102,80,20" HitTest="true" CharFilter="Digits" MaxLength="7"
             FontColor="#080808"/>
    <ImageButton Name="BankMoneyWithdraw" Picture="Btn_ArrowR_5" Position="184,96" Size="17,17" Hint="Withdraw"
                 Click="onBankMoneyWithdraw"/>
    <TextBox Name="BankMoneyWithdrawAmount" Bounds="69,102,80,20" HitTest="true" CharFilter="Digits" MaxLength="7"
             FontColor="#080808"/>
  </Window>
</Panel>
