    <CheckBox Name="RemoteCheck1" Picture="btn_UnCheck_1" CheckedPicture="btn_Check_1" Position="19,48" Size="16,16" Click="onRemoteCheck"/>
    <ImageButton Name="RemoteStop" Picture="Btn_Stop_2" Position="83,463" Size="39,20" Click="onRemoteStop"/>
    <ImageButton Name="RemoteOk" Picture="Btn_OK_2" Position="34,463" Size="39,20" Click="onRemoteOk"/>
    <ImageButton Name="RemoteClose" Picture="Btn_Close_2" Position="132,463" Size="39,20" Click="onRemoteClose"/>
    <DrawingArea Name="RemoteHints" Bounds="0,0,227,501"/>
