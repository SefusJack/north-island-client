         an odd height keeps its two-row stripes in step where the repeats meet the bottom -->
    <Panel Name="SettingsFrame" Bounds="0,0,410,387" Skin="form_module_1" SkinSource="0,0,223,223" Borders="64,122,80,45"/>
    <Label Name="SettingsTitle" Position="34,22" Text="System" FontColor="#1E3C78" Effect="Plain"/>
