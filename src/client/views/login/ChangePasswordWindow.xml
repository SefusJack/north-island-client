<?xml version="1.0" encoding="utf-8"?>
<!-- The change password form (TSe_ChangePassWordForm, Change Password in the system window);
     view model: viewmodels/ChangePasswordWindow.cpp.  The first three rows only show stars; the
     old password and the new one twice go below.  OK asks and sends 35/1.  The game draws a
     form's controls from the last created to the first: the controls here are in drawing order,
     the reverse of TSe_ChangePassWordForm.Create. -->
<Panel Name="ChangePasswordLayer" Bounds="0,0,800,600">
  <Window Name="ChangePassword" Escape="onChangePasswordCancel" Picture="Form_ChangePassword_1" Position="180,146" Visible="false">
    <TextBox Name="ChangePassword6" Bounds="108,222,102,12" HitTest="true" Password="true" CharFilter="Alphanumeric"
             MaxLength="10" AllowPaste="true" FontColor="#080808" Enter="onChangePasswordNext" Tab="onChangePasswordNext"/>
    <TextBox Name="ChangePassword5" Bounds="108,193,102,12" HitTest="true" Password="true" CharFilter="Alphanumeric"
             MaxLength="10" AllowPaste="true" FontColor="#080808" Enter="onChangePasswordNext" Tab="onChangePasswordNext"/>
    <TextBox Name="ChangePassword4" Bounds="108,164,102,12" HitTest="true" Password="true" CharFilter="Alphanumeric"
             MaxLength="10" AllowPaste="true" FontColor="#080808" Enter="onChangePasswordNext" Tab="onChangePasswordNext"/>
    <TextBox Name="ChangePassword3" Bounds="108,135,102,12" Password="true" ReadOnly="true" FontColor="#525152"/>
    <TextBox Name="ChangePassword2" Bounds="108,106,102,12" Password="true" ReadOnly="true" FontColor="#525152"/>
    <TextBox Name="ChangePassword1" Bounds="108,77,102,12" Password="true" ReadOnly="true" FontColor="#525152"/>
    <ImageButton Name="ChangePasswordCancel" Picture="btn_cancel_1" Position="248,268" Click="onChangePasswordCancel"
                 ClickSound="" ReleaseSound="sound/wav0154.wav"/>
    <ImageButton Name="ChangePasswordOk" Picture="btn_ok_1" Position="138,268" Click="onChangePasswordOk"/>
    <ImageButton Name="ChangePasswordCloseSmall" Picture="Btn_Close_s_1" Position="387,23" Size="18,18"
                 Click="onChangePasswordCancel" ClickSound="" ReleaseSound="sound/wav0154.wav"/>
  </Window>
</Panel>
