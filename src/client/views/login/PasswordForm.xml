<?xml version="1.0" encoding="utf-8"?>
<!-- Password and cipher form (TRe_InputPwAndDarkPw); view model: viewmodels/PasswordForm.cpp.
     Mode "set" (character creation): background Form_InputPw_1, Previous left, OK right.
     Mode "confirm" (deleting a character): background Form_InputPw_2, OK left, Cancel right.
     Only the cipher fields (3 and 4) take input; 1 and 2 show stars. -->
<Panel Name="PasswordForm" Bounds="0,0,800,600" Visible="false">
  <Panel Name="PasswordModeSet" Bounds="0,0,800,600" Visible="false">
    <Image Name="PasswordSetBackground" Source="Menu/Skins/White/Form_InputPw_1.jpg" Position="126,135"/>
    <ImageButton Name="PasswordSetPrevious" Picture="Btn_Prev_1" Bounds="468,447,56,20" Click="onPasswordCancel"/>
    <ImageButton Name="PasswordSetOk" Picture="Btn_Ok_1" Bounds="570,447,56,20" Click="onPasswordOk"/>
  </Panel>
  <Panel Name="PasswordModeConfirm" Bounds="0,0,800,600" Visible="false">
    <Image Name="PasswordConfirmBackground" Source="Menu/Skins/White/Form_InputPw_2.jpg" Position="126,135"/>
    <ImageButton Name="PasswordConfirmOk" Picture="Btn_Ok_1" Bounds="468,447,56,20" Click="onPasswordOk"/>
    <ImageButton Name="PasswordConfirmCancel" Picture="Btn_Cancel_1" Bounds="570,447,56,20" Click="onPasswordCancel"/>
  </Panel>
  <TextBox Name="PasswordField1" Bounds="267,258,137,14" Skin="Panel26" SkinSource="0,0,104,21" Borders="1,1,1,1"
           FontColor="#525152" MaxLength="14" Password="true" ReadOnly="true" Enter="onPasswordNext" Tab="onPasswordNext" Click="onPasswordField"/>
  <TextBox Name="PasswordField2" Bounds="267,306,137,14" Skin="Panel26" SkinSource="0,0,104,21" Borders="1,1,1,1"
           FontColor="#525152" MaxLength="14" Password="true" ReadOnly="true" Enter="onPasswordNext" Tab="onPasswordNext" Click="onPasswordField"/>
  <TextBox Name="PasswordField3" Bounds="267,354,137,14" Skin="Panel26" SkinSource="0,0,104,21" Borders="1,1,1,1"
           FontColor="#080808" MaxLength="10" Password="true" Enter="onPasswordNext" Tab="onPasswordNext" Click="onPasswordField"/>
  <TextBox Name="PasswordField4" Bounds="267,402,137,14" Skin="Panel26" SkinSource="0,0,104,21" Borders="1,1,1,1"
           FontColor="#080808" MaxLength="10" Password="true" Enter="onPasswordNext" Tab="onPasswordNext" Click="onPasswordField"/>
</Panel>
