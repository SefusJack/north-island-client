    <ImageButton Name="FishAnnotateClose" Picture="Btn_Close_1" Position="145,456" Size="56,20" Click="onFishAnnotateClose"/>
    <ImageButton Name="FishAnnotateCloseSmall" Picture="Btn_Close_S_1" Position="299,26" Size="18,18" Click="onFishAnnotateClose"/>
  </Window>
</Panel>
