<?xml version="1.0" encoding="utf-8"?>
<!-- The form of the own authority in the guild (TTH_MYauthorityForm), opened by Authority of
     the guild tab's member page; view model: viewmodels/GuildMyAuthorityForm.cpp.  Marks the
     rights the own player has: invite, modify emblem, hold the post of vice lord.  The game
     draws a form's controls from the last created to the first: the controls here are in
     drawing order, the reverse of TTH_MYauthorityForm.Create. -->
<Panel Name="GuildMyAuthorityLayer" Bounds="0,0,800,600">
  <Window Name="GuildMyAuthorityForm" Escape="onGuildMyAuthorityClose" Picture="Form_MYauthority_1" Position="150,100" Visible="false">
    <Image Name="GuildMyViceMark" Picture="icon_check_1" Position="35,139" Visible="false"/>
    <Image Name="GuildMyMark5" Picture="icon_check_1" Position="35,119" Visible="false"/>
    <Image Name="GuildMyMark4" Picture="icon_check_1" Position="35,139" Visible="false"/>
    <Image Name="GuildMyMark3" Picture="icon_check_1" Position="35,119" Visible="false"/>
    <Image Name="GuildMyMark2" Picture="icon_check_1" Position="35,99" Visible="false"/>
    <Image Name="GuildMyMark1" Picture="icon_check_1" Position="17,80" Visible="false"/>
    <ImageButton Name="GuildMyClose" Picture="Btn_Close_1" Position="90,310" Hint="[ESC]" Click="onGuildMyAuthorityClose"
                 ClickSound="" ReleaseSound="sound/wav0154.wav"/>
    <ImageButton Name="GuildMyCloseSmall" Picture="Btn_Close_s_1" Position="190,24" Click="onGuildMyAuthorityClose"
                 ClickSound="" ReleaseSound="sound/wav0154.wav"/>
    <TextBox Name="GuildMyName" Bounds="20,40,90,40" ReadOnly="true" FontColor="#080808"/>
  </Window>
</Panel>
