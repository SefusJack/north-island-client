<?xml version="1.0" encoding="utf-8"?>
<!-- The authority form of the guild (TTH_setauthorityForm), opened by Set Authority of the guild
     tab's member page; view model: viewmodels/GuildAuthorityForm.cpp.  Ticks the rights of the
     ticked members (the lord also whether one is a vice lord); OK sends them (39/16, and 39/14 or
     39/11 for the vice lord's post).  The game draws a form's controls from the last created to
     the first: the controls here are in drawing order, the reverse of TTH_setauthorityForm.Create. -->
<Panel Name="GuildAuthorityLayer" Bounds="0,0,800,600">
  <Window Name="GuildAuthority" Escape="onGuildAuthorityClose" Picture="Form_setauthority_1" Position="150,100" Visible="false">
    <ImageButton Name="GuildAuthorityVice" Picture="btn_UnCheck_1" Position="35,139" Click="onGuildAuthorityVice"/>
    <ImageButton Name="GuildAuthorityCheck5" Picture="btn_UnCheck_1" Position="35,119" Click="onGuildAuthorityCheck"/>
    <ImageButton Name="GuildAuthorityCheck4" Picture="btn_UnCheck_1" Position="35,139" Visible="false" Click="onGuildAuthorityCheck"/>
    <ImageButton Name="GuildAuthorityCheck3" Picture="btn_UnCheck_1" Position="35,119" Visible="false" Click="onGuildAuthorityCheck"/>
    <ImageButton Name="GuildAuthorityCheck2" Picture="btn_UnCheck_1" Position="35,99" Click="onGuildAuthorityCheck"/>
    <ImageButton Name="GuildAuthorityCheck1" Picture="btn_UnCheck_1" Position="16,79" Visible="false" Click="onGuildAuthorityCheck"/>
    <ImageButton Name="GuildAuthorityClose" Picture="Btn_Close_1" Position="110,310" Hint="[ESC]" Click="onGuildAuthorityClose"
                 ClickSound="" ReleaseSound="sound/wav0154.wav"/>
    <ImageButton Name="GuildAuthorityOk" Picture="Btn_OK_1" Position="40,310" Click="onGuildAuthorityOk"/>
    <ImageButton Name="GuildAuthorityCloseSmall" Picture="Btn_Close_s_1" Position="190,24" Click="onGuildAuthorityClose"
                 ClickSound="" ReleaseSound="sound/wav0154.wav"/>
    <TextBox Name="GuildAuthorityName" Bounds="20,40,90,40" ReadOnly="true" FontColor="#080808"/>
    <!-- DrawControl: the vice lord's tick shows for one ticked member only -->
    <DrawingArea Name="GuildAuthorityUpdate" Bounds="0,0,1,1"/>
  </Window>
</Panel>
