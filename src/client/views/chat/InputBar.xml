  <ImageButton Name="InputChannelPick2" Picture="btn_channel_1_1" Bounds="31,532,40,21" DrawHeight="21" Visible="false" Click="onInputChannelPick"/>
  <ImageButton Name="InputChannelPick1" Picture="btn_channel_1_1" Bounds="31,552,40,21" DrawHeight="21" Visible="false" Click="onInputChannelPick"/>
  <ImageButton Name="InputChannel" Picture="btn_channel_2_1" Bounds="31,577,40,21" DrawHeight="21" Hint="switch to chat channel"
               Click="onInputChannel"/>
