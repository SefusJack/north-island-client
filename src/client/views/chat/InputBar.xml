<?xml version="1.0" encoding="utf-8"?>
<!-- The chat input bar along the bottom of the world (TSe_InputBar); view model:
     viewmodels/InputBar.cpp.  The channel picture under the mail envelope and the channel
     button change with the channel; over the button the frame of the other channels opens.
     The game draws a form's controls from the last created to the first: the frame lies under
     its buttons, they under the channel button. -->
<Panel Name="InputBar" Bounds="0,0,800,600" Anchor="BottomLeft" HudScale="true" Visible="false">
  <Image Name="InputBackground" Picture="main_input_1" Position="0,575"/>
  <!-- the size of one frame of the mail icon strip -->
  <Spot Name="InputMailFrame" Size="23,21"/>
  <!-- the channel button's hit area, and the open channel pick list's hit area -->
  <Spot Name="InputChannelButtonArea" Bounds="28,575,40,21"/>
  <Spot Name="InputChannelFrameArea" Bounds="28,448,40,127"/>
  <!-- the whisper name field's hit area, and its bounds once a target is chosen -->
  <Spot Name="InputWhisperFieldArea" Bounds="70,576,86,22"/>
  <Spot Name="InputWhisperChosenField" Bounds="73,575,88,24"/>
  <!-- the whisper names panel: x, the top of the input bar, width, and the height of one name row -->
  <Spot Name="InputWhisperPanel" Bounds="24,575,140,20"/>
  <!-- the whisper names list inside its panel -->
  <Spot Name="InputWhisperNamesInPanel" Position="25,8"/>
  <!-- the typed line's text, where the emote icons are drawn: top-left -->
  <Spot Name="InputLineEmotes" Position="165,577"/>
  <Image Name="InputChannelMark" Bounds="6,577,21,19"/>
  <Image Name="InputMail" Picture="Anim_GotMailS_1" Bounds="4,577,23,21" SourceRect="0,0,23,21"/>
  <DrawingArea Name="InputMailArea" Bounds="8,576,22,22" HitTest="true" MouseUp="onInputMail"/>
  <TextBox Name="InputText" Bounds="162,577,328,20" FontColor="#FFFFFF" MaxLength="60" HitTest="true"
           Hint="Press Ctrl + V to paste conversation information"
           Enter="onInputSend" Up="onInputPrevious" Down="onInputNext" WheelUp="onInputPrevious"
           WheelDown="onInputNext" Click="onInputTextClick"/>
  <TextBox Name="InputWhisperName" Bounds="73,577,88,20" FontColor="#FFFFFF" MaxLength="15" HitTest="true"
           Visible="false" ReadOnly="true" Enter="onInputWhisperEnter" Click="onInputWhisperClick"/>
  <ListBox Name="InputWhisperNames" Bounds="49,571,140,0" FontColor="#FFFFFF" Visible="false"
           Select="onInputWhisperPick"/>
  <!-- FExitGuestBtn: while watching a battle -->
  <ImageButton Name="InputQuitViewing" Picture="Btn_ExitGuest_1" Bounds="700,535,28,28" Frames="1" Hint="Quit viewing"
               Visible="false" Click="onInputQuitViewing"/>
  <Panel Name="InputChannelFrame" Bounds="28,488,46,87" Skin="icon_Channelframe_1" SkinSource="0,0,46,67" Visible="false"/>
  <ImageButton Name="InputChannelPick4" Picture="btn_channel_1_1" Bounds="31,492,40,21" DrawHeight="21" Visible="false" Click="onInputChannelPick"/>
