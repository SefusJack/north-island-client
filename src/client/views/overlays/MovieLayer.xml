<?xml version="1.0" encoding="utf-8"?>
<!-- The story movie (FT_Movie_Object.pas DrawMovie): the whole screen, black, with the ground picture, the moving pictures and the fills the script
     asks for painted by the view model, which also takes the clicks so that none reaches the map (the movie branch of the frame loop gives the mouse to
     the forms only).  Shown while the screen mode is 1, 3 or 4.  View model: viewmodels/MovieLayer.cpp. -->
<Panel Name="MovieLayer" Bounds="0,0,800,600" Visible="false">
  <DrawingArea Name="MoviePage" Bounds="0,0,800,600" HitTest="true">
    <!-- the whole game screen, which the ground's fade darkens -->
    <Spot Name="MovieScreen" Bounds="0,0,800,600"/>
  </DrawingArea>
</Panel>
