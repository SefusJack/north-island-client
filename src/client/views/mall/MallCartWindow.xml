             FontColor="#080808" Visible="false"/>
    <TextBox Name="CartCount2" Bounds="400,119,28,14" HitTest="true" Align="Right" CharFilter="Digits" MaxLength="3"
             FontColor="#080808" Visible="false"/>
    <TextBox Name="CartCount1" Bounds="400,60,28,14" HitTest="true" Align="Right" CharFilter="Digits" MaxLength="3"
             FontColor="#080808" Visible="false"/>
    <ImageButton Name="CartDelete7" Picture="Btn_DelItem" Bounds="445,412,56,20" Visible="false" Click="onCartDelete"
                 ClickSound="" ReleaseSound="sound/wav0154.wav"/>
