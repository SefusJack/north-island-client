<?xml version="1.0" encoding="utf-8"?>
<!-- The gold menu (TCY_MoneyMenu, Ctrl+G or the gold button); view model:
     viewmodels/MoneyMenu.cpp.  The gold carried, Discard (the place-money box), the trades
     (the next player clicked) and the stalls.  The game draws a form's controls from the last
     created to the first: the controls here are in drawing order, the reverse of
     TCY_MoneyMenu.Create. -->
<Panel Name="MoneyMenuLayer" Bounds="0,0,800,600">
  <Window Name="MoneyMenu" Escape="onMoneyMenuEscape" Picture="Form_Business_1" Position="540,180" Visible="false">
    <DrawingArea Name="MoneyGold" Bounds="0,0,260,189">
      <!-- the gold text: near-black (RGB565 2113) -->
      <Spot Name="MoneyGoldColor" Color="#080808"/>
    </DrawingArea>
    <ImageButton Name="MoneyClose" Picture="Btn_Close_1" Position="102,153" Hint="[ESC]" Click="onMoneyClose"
                 ClickSound="" ReleaseSound="sound/wav0154.wav"/>
    <ImageButton Name="MoneyStallUtensil" Picture="Btn_StallUtensil_1" Position="167,124" Click="onMoneyStallUtensil"/>
    <ImageButton Name="MoneyStallPet" Picture="Btn_StallPet_1" Position="94,124" Click="onMoneyStallPet"/>
    <ImageButton Name="MoneyStallItem" Picture="Btn_StallThing_1" Position="21,124" Click="onMoneyStallItem"/>
    <ImageButton Name="MoneyTradeUtensil" Picture="Btn_TradeUtensil_1" Position="167,96" Click="onMoneyTradeUtensil"/>
    <ImageButton Name="MoneyTradePet" Picture="Btn_TradePet_1" Position="94,96" Hint="Trade pet" Click="onMoneyTradePet"/>
    <ImageButton Name="MoneyTradeItem" Picture="btn_TradeThing_1" Position="21,96" Hint="Trade item" Click="onMoneyTradeItem"/>
    <ImageButton Name="MoneyDiscard" Picture="Btn_Abandon_1" Position="174,68" Hint="Place money" Click="onMoneyDiscard"/>
    <ImageButton Name="MoneyCloseSmall" Picture="Btn_Close_s_1" Position="209,24" Click="onMoneyClose"
                 ClickSound="" ReleaseSound="sound/wav0154.wav"/>
  </Window>
</Panel>
