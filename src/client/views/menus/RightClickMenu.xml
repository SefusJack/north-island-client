<?xml version="1.0" encoding="utf-8"?>
<!-- The little menu beside a bag item that was clicked with the right mouse button (TRightClickForm); view model:
     viewmodels/RightClickMenu.cpp.  For the HP and SP Bottles it holds "Put in" over Cancel.  The game draws a form's controls from the
     last created to the first: the controls here are in drawing order, the reverse of TRightClickForm.Create. -->
<Panel Name="RightClickMenuLayer" Bounds="0,0,800,600" Topmost="true">
  <Panel Name="RightClickMenu" Bounds="0,0,71,40" Visible="false">
    <ImageButton Name="RightClickPutIn" Picture="Btn_MagicPutIn_1" Position="0,0" Click="onRightClickPutIn"/>
    <ImageButton Name="RightClickCancel" Picture="Btn_Cancel_5" Position="0,20" Click="onRightClickCancel"/>
  </Panel>
</Panel>
