<?xml version="1.0" encoding="utf-8"?>
<!-- The Storeroom (TRe_GarageForm, the piece 39030 and the Super Handbag): 50 cells in the middle of the screen; items are dragged between it and the
     bag, or within it (62/7 to 62/9).  The game draws a form's controls from the last created to the first: the controls here are in drawing order,
     the reverse of TRe_GarageForm.Create.  View model: viewmodels/StoreroomWindow.cpp. -->
<Panel Name="StoreroomLayer" Bounds="0,0,800,600">
  <Window Name="StoreroomWindow" AbovePopups="true" Escape="onStoreroomClose" Picture="Form_Garage_1" Position="295,69" Size="209,461" Visible="false">
    <!-- DrawControl: the warehouse icon -->
    <DrawingArea Name="StoreroomPage" Bounds="0,0,209,461">
      <!-- the warehouse icon's position -->
      <Spot Name="StoreroomIcon" Position="66,11"/>
    </DrawingArea>
    <IconGrid Name="StoreroomCells" Position="19,74" Columns="5" Rows="10" Pitch="34" Draggable="true" Drop="onStoreroomDrop"/>
    <ImageButton Name="StoreroomCloseSmall" Picture="Btn_Close_s_1" Position="159,26" Size="18,18" Click="onStoreroomClose"/>
    <ImageButton Name="StoreroomSort" Picture="Btn_Module_2" Position="16,48" Size="32,20" Narrow="true" IconLines="3,0 3,11; 0,3 3,0 6,3; 10,0 10,11; 7,8 10,11 13,8" IconWidth="2" Hint="Sort (qol)" Visible="false" Click="onStoreroomSort"/>
    <ImageButton Name="StoreroomClose" Picture="Btn_Close_1" Position="76,425" Size="56,20" Click="onStoreroomClose"/>
  </Window>
</Panel>
