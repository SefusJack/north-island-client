<?xml version="1.0" encoding="utf-8"?>
<!-- The prizes of the online draw (TLa_LotteryOLViewForm, a click on the prize): each with its picture and name, ten to a column.  View model:
     viewmodels/LotteryPrizesWindow.cpp. -->
<Panel Name="LotteryPrizesLayer" Bounds="0,0,800,600">
  <Window Name="LotteryPrizesWindow" AbovePopups="true" Escape="onLotteryPrizesClose" ScreenFit="true" Position="296,60" Size="207,427" Visible="false">
    <!-- the picture, stretched to the width of the columns, then the title, the prizes and their names -->
    <DrawingArea Name="LotteryPrizesPage" Bounds="0,0,207,427">
      <!-- the window with one column of prizes (width, height), and the width added per further column -->
      <Spot Name="LotteryPrizesForm" Size="207,427" Pitch="130,0"/>
      <!-- an item icon -->
      <Spot Name="LotteryPrizesIcon" Size="32,32"/>
      <!-- the text colour (near black, in RGB565 2113) -->
      <Spot Name="LotteryPrizesTextColor" Color="#080808"/>
    </DrawingArea>
    <ImageButton Name="LotteryPrizesCancel" Picture="Btn_Cancel_1" Position="83,400" Size="56,20" Click="onLotteryPrizesClose"/>
    <ImageButton Name="LotteryPrizesClose" Picture="Btn_Close_S_1" Position="187,2" Size="18,18" Hint="Close" Click="onLotteryPrizesClose"/>
  </Window>
</Panel>
