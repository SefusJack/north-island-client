<?xml version="1.0" encoding="utf-8"?>
<!-- The announcement form of an event (TBK_AnnounceForm, opened by the server's 36/1 with its text in 36/2); view model: viewmodels/AnnounceWindow.cpp.  The text in a
     panel with a scroll bar beside it, a Close button hinted [ESC]; closing lets the event go on.  Made in the middle of the screen.  The game draws a form's controls
     from the last created to the first: the controls here are in drawing order, the reverse of TBK_AnnounceForm.Create. -->
<Panel Name="AnnounceLayer" Bounds="0,0,800,600">
  <Window Name="Announce" Escape="onAnnounceClose" Position="253,148" Size="294,303" Visible="false">
    <Panel Name="AnnounceFrame" Bounds="0,0,294,303" Skin="form_module" SkinSource="0,0,200,180" Borders="64,38,44,14"/>
    <ImageButton Name="AnnounceClose" Picture="Btn_Close_1" Position="112,266" Size="70,25" Click="onAnnounceClose" ClickSound="" ReleaseSound="sound/wav0154.wav"
                 Hint="[ESC]"/>
    <ImageButton Name="AnnounceCloseSmall" Picture="Btn_Close_s_1" Position="271,5" Size="17,17" Click="onAnnounceClose" ClickSound="" ReleaseSound="sound/wav0154.wav"/>
    <ScrollBar Name="AnnounceScroll" Bounds="266,42,20,217" Track="rail_H3" Thumb="bar_H3" ThumbSource="0,0,12,130" ThumbCap="16" TrackCap="20"/>
    <Panel Name="AnnouncePanel" Bounds="22,42,244,217" Skin="panel10" SkinSource="0,0,50,50" Borders="7,7,7,7">
      <Memo Name="AnnounceText" Bounds="6,4,240,217" FontColor="#FFFFFF" Effect="Plain" ReadOnly="true"/>
    </Panel>
  </Window>
</Panel>
