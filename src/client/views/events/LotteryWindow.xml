<?xml version="1.0" encoding="utf-8"?>
<!-- The online draw (TLa_LotteryOLForm, the Online draw button): the picture of the prize that runs through the prizes while it is drawn, how many
     draws are left, Draw and Close.  The game draws a form's controls from the last created to the first: the controls here are in drawing
     order, the reverse of TLa_LotteryOLForm.Create.  View model: viewmodels/LotteryWindow.cpp. -->
<Panel Name="LotteryLayer" Bounds="0,0,800,600">
  <Window Name="LotteryWindow" Escape="onLotteryClose" Picture="Form_LotteryOL" Position="314,208" Size="171,183" Visible="false">
    <!-- DrawControl: the draws left -->
    <DrawingArea Name="LotteryPage" Bounds="0,0,171,183">
      <!-- the "draws left" number, and the text colour (near black, in RGB565 2113) -->
      <Spot Name="LotteryDrawsLeft" Position="84,116"/>
      <Spot Name="LotteryTextColor" Color="#080808"/>
    </DrawingArea>
    <DrawingArea Name="LotteryPrize" Bounds="69,72,40,40" HitTest="true" Hint="Click to view rewards list" MouseUp="onLotteryPrize"/>
    <ImageButton Name="LotteryDraw" Picture="Btn_LotteryOL" Position="37,142" Size="39,20" Click="onLotteryDraw"
                 ClickSound="" ReleaseSound="sound/wav0154.wav"/>
    <ImageButton Name="LotteryClose" Picture="Btn_Close_2" Position="92,142" Size="39,20" Hint="[ESC]" Click="onLotteryClose"
                 ClickSound="" ReleaseSound="sound/wav0154.wav"/>
    <ImageButton Name="LotteryCloseSmall" Picture="Btn_Close_s_1" Position="145,5" Size="18,18" Hint="[ESC]" Click="onLotteryClose"
                 ClickSound="" ReleaseSound="sound/wav0154.wav"/>
  </Window>
</Panel>
