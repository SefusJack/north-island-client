<?xml version="1.0" encoding="utf-8"?>
<!-- The fusion scrolls' form (TReinforceForm, opened by using a fusion scroll: Seraph 34238, Demon 34239, Cherubim 34243, Ofanim 34244, Virtues 34245, Principality
     34246, Small Demon 34247, Archangel 34255); view model: viewmodels/ReinforceWindow.cpp.  A piece of gear of the bag is dropped on the place (the right button takes
     it out), OK asks "Use <scroll>?" and sends 23/121.  A TSe_Form (it is kept on the screen); the view model places it beside the item window.  The game draws a
     form's controls from the last created to the first: the controls here are in drawing order, the reverse of TReinforceForm.Create; DrawControl's texts are under
     them. -->
<Panel Name="ReinforceLayer" Bounds="0,0,800,600">
  <Window Name="Reinforce" Escape="onReinforceClose" Picture="Form_Reinforce_1" Position="200,100" Size="207,345" ScreenFit="true" Visible="false">
    <DrawingArea Name="ReinforcePaint" Bounds="0,0,207,345">
      <!-- the scroll's name, in RGB565 31 (blue) -->
      <Spot Name="ReinforceScrollName" Color="#0000FF"/>
      <!-- the "+N" level, in RGB565 2113 -->
      <Spot Name="ReinforceLevel" Color="#080808"/>
    </DrawingArea>
    <DrawingArea Name="ReinforceImage" Bounds="89,185,30,30" HitTest="true" RightMouseUp="onReinforceTake">
      <!-- the stack count inside the icon, in RGB565 2113 -->
      <Spot Name="ReinforceCount" Position="2,20" Color="#080808"/>
    </DrawingArea>
    <ImageButton Name="ReinforceOk" Picture="Btn_OK_2" Position="57,307" Size="39,20" Click="onReinforceOk" ClickSound="" ReleaseSound="sound/wav0154.wav"/>
    <ImageButton Name="ReinforceCancel" Picture="Btn_Cancel_3" Position="112,307" Size="39,20" Hint="[ESC]" Click="onReinforceClose" ClickSound=""
                 ReleaseSound="sound/wav0154.wav"/>
    <ImageButton Name="ReinforceCloseSmall" Picture="Btn_Close_s_1" Position="157,26" Size="18,18" Hint="[ESC]" Click="onReinforceClose" ClickSound=""
                 ReleaseSound="sound/wav0154.wav"/>
  </Window>
</Panel>
