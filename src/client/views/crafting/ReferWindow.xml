<?xml version="1.0" encoding="utf-8"?>
<!-- The Magnifying Glass's form (TReferToMaterial, opened by using a Magnifying Glass 34179); view model: viewmodels/ReferWindow.cpp.  An item of the bag is dropped on the form
     (the place takes it, the right button takes it out), Query asks and sends 23/103; the answer is drawn by ReferPaint.  A TSe_Form (kept on the screen); the view model places it
     beside the item window.  The game draws a form's controls from the last created to the first: the controls here are in drawing order, the reverse of
     TReferToMaterial.Create. -->
<Panel Name="ReferLayer" Bounds="0,0,800,600">
  <Window Name="ReferWindow" Escape="onReferClose" Picture="Form_Alchemist" Position="200,100" Size="221,372" ScreenFit="true" Visible="false">
    <DrawingArea Name="ReferPaint" Bounds="0,0,221,372">
      <!-- the searched item's name, and the text colour of the material names too (RGB565 31, blue) -->
      <Spot Name="ReferName" Position="69,60" Color="#0000FF"/>
      <!-- where the first and second result numbers start -->
      <Spot Name="ReferFirstNumber" Position="126,86"/>
      <Spot Name="ReferSecondNumber" Position="126,110"/>
      <!-- the first material picture, and the step down to each next one -->
      <Spot Name="ReferMaterialPicture" Position="71,137" Pitch="0,34"/>
      <!-- the first material name, and the step down to each next one -->
      <Spot Name="ReferMaterialName" Position="115,146" Pitch="0,33"/>
    </DrawingArea>
    <DrawingArea Name="ReferImage" Bounds="20,46,32,32" HitTest="true" RightMouseUp="onReferTake"/>
    <ImageButton Name="ReferCloseSmall" Picture="Btn_Close_S_1" Position="174,25" Size="18,18" Click="onReferClose"/>
    <ImageButton Name="ReferCancel" Picture="Btn_Cancel_1" Position="82,337" Size="56,20" Click="onReferClose" ReleaseSound="sound/wav0154.wav"/>
    <ImageButton Name="ReferQuery" Picture="Btn_Query" Position="82,313" Size="56,20" Click="onReferQuery"/>
  </Window>
</Panel>
