<?xml version="1.0" encoding="utf-8"?>
<!-- The compound window (TRe_CompoundForm, the Compound button); view model:
     viewmodels/CompoundWindow.cpp.  A copy of the bag on the left: an item clicked there goes
     into the first free of the five slots on the right (the main material first), the right
     button takes it out again.  Synthesis asks the server to compound them; the cauldron
     boils and what was made flies into its bag cell.  With the alchemy skills the junior box
     or the skill menu choose how.  The game draws a form's controls from the last created to
     the first: the controls here are in drawing order, the reverse of
     TRe_CompoundForm.Create. -->
<Panel Name="CompoundWindowLayer" Bounds="0,0,800,600">
  <Window Name="CompoundWindow" Escape="onCompoundWindowEscape" Picture="Form_Compound_1" Position="250,66" Visible="false">
    <!-- DrawControl: the frames of large items, the cauldron, the item flying into the bag and
         the skill menu's marks -->
    <DrawingArea Name="CompoundPaint" Bounds="0,0,299,467">
      <!-- the cauldron animation -->
      <Spot Name="CompoundCauldron" Position="238,162"/>
      <!-- where the result icon starts flying from -->
      <Spot Name="CompoundFlight" Position="260,70"/>
      <!-- the count text in a slot, in RGB565 2113 -->
      <Spot Name="CompoundCount" Color="#080808"/>
    </DrawingArea>
    <DrawingArea Name="CompoundSlot5" Bounds="206,383,66,32" HitTest="true" RightMouseDown="onCompoundSlotRemove"/>
    <DrawingArea Name="CompoundSlot4" Bounds="206,332,66,32" HitTest="true" RightMouseDown="onCompoundSlotRemove"/>
    <DrawingArea Name="CompoundSlot3" Bounds="206,281,66,32" HitTest="true" RightMouseDown="onCompoundSlotRemove"/>
    <DrawingArea Name="CompoundSlot2" Bounds="206,230,66,32" HitTest="true" RightMouseDown="onCompoundSlotRemove"/>
    <DrawingArea Name="CompoundSlot1" Bounds="206,167,66,44" HitTest="true" RightMouseDown="onCompoundSlotRemove"/>
    <ImageButton Name="CompoundSynthesis" Picture="Btn_Compound_1" Position="83,429" Click="onCompoundSynthesis"/>
    <TextBox Name="CompoundJuniorLabel" Bounds="38,53,150,10" ReadOnly="true" FontColor="#080808" Visible="false"/>
    <ImageButton Name="CompoundJuniorCheck" Picture="btn_UnCheck_1" Position="21,50" Visible="false" Click="onCompoundJunior"/>
    <ImageButton Name="CompoundSkill1" Picture="Btn_CompSk_1" Position="56,25" Visible="false" Click="onCompoundSkillChosen"/>
    <ImageButton Name="CompoundSkill2" Picture="Btn_CompSk_2" Position="56,5" Visible="false" Click="onCompoundSkillChosen"/>
    <ImageButton Name="CompoundSkill3" Picture="Btn_CompSk_3" Position="56,-15" Visible="false" Click="onCompoundSkillChosen"/>
    <ImageButton Name="CompoundSkill" Picture="Btn_CompSk_1" Position="56,47" Visible="false" Click="onCompoundSkillMenu"/>
    <ImageButton Name="CompoundClose" Picture="Btn_Close_1" Position="159,429" Click="onCompoundClose"
                 ClickSound="" ReleaseSound="sound/wav0154.wav"/>
    <ImageButton Name="CompoundCloseSmall" Picture="Btn_Close_S_1" Position="249,24" Click="onCompoundClose"
                 ClickSound="" ReleaseSound="sound/wav0154.wav"/>
    <IconGrid Name="CompoundBag" Position="24,77" Columns="5" Rows="10" Pitch="34" Click="onCompoundBagClick"
              RightClick="onCompoundBagRemove"/>
  </Window>
</Panel>
