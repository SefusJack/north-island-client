<?xml version="1.0" encoding="utf-8"?>
<!-- The Magic Magnet's form (THL_MagnetForm, a double click on the Magic Magnet 34021 and "Use Magic Magnet"): the name of the player to pull to the
     wearer, typed or picked from the friends and guild members that are online (the two ticks filter them; a double click on a row types it), OK sends
     23/90.  The game draws a form's controls from the last created to the first: the controls here are in drawing order, the reverse of THL_MagnetForm.Create.
     View model: viewmodels/MagnetWindow.cpp. -->
<Panel Name="MagnetLayer" Bounds="0,0,800,600">
  <Window Name="MagnetWindow" AbovePopups="true" Escape="onMagnetClose" Picture="Form_Magnet_1" Position="286,100" Size="228,399" Visible="false">
    <ImageButton Name="MagnetDown" Picture="Btn_ArrowDn_1" Position="192,348" Size="17,17" Click="onMagnetDown"/>
    <ImageButton Name="MagnetUp" Picture="Btn_ArrowUp_1" Position="192,106" Size="17,17" Click="onMagnetUp"/>
    <ImageButton Name="MagnetClose" Picture="Btn_Close_2" Position="113,366" Size="39,20" Hint="[ESC]" Click="onMagnetClose"
                 ClickSound="" ReleaseSound="sound/wav0154.wav"/>
    <ImageButton Name="MagnetCloseSmall" Picture="Btn_Close_s_1" Position="178,26" Size="18,18" Hint="[ESC]" Click="onMagnetClose"
                 ClickSound="" ReleaseSound="sound/wav0154.wav"/>
    <ListBox Name="MagnetNames" Bounds="22,118,163,236" RowHeight="26" FontColor="#FFFFFF" HighlightColor="#89BFF5"
             FocusFrame="false" TextShadow="false" TextOffset="10,3" ScrollBar="MagnetScroll" DoubleClick="onMagnetPick"/>
    <ScrollBar Name="MagnetScroll" Bounds="192,123,17,226" Track="Rail_H5" TrackCap="16" Thumb="bar_H4" ThumbSource="0,0,9,21" ThumbCap="7" ThumbInset="3"/>
    <CheckBox Name="MagnetGuild" Picture="btn_UnCheck_1" CheckedPicture="btn_Check_1" Checked="true" Position="76,89" Size="16,16" Click="onMagnetFilter"/>
    <CheckBox Name="MagnetFriends" Picture="btn_UnCheck_1" CheckedPicture="btn_Check_1" Checked="true" Position="20,89" Size="16,16" Click="onMagnetFilter"/>
    <ImageButton Name="MagnetUse" Picture="Btn_OK_2" Position="68,366" Size="39,20" Hint="Use" Click="onMagnetUse"
                 ClickSound="" ReleaseSound="sound/wav0154.wav"/>
    <TextBox Name="MagnetName" Bounds="96,64,86,20" Skin="Panel26" SkinSource="0,0,104,14" Borders="1,1,1,1" HitTest="true" MaxLength="14"
             AllowPaste="true" FontColor="#080808"/>
  </Window>
</Panel>
