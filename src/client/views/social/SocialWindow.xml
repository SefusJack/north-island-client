    <DrawingArea Name="FriendPage" Bounds="0,0,356,493">
      <!-- the top left of the first friend row, one row down each step -->
      <Spot Name="FriendRow" Position="25,70" Pitch="0,65"/>
      <!-- inside a row: the face portrait and the level digits -->
      <Spot Name="FriendFace" Position="31,27"/>
      <Spot Name="FriendLevel" Position="180,3"/>
      <!-- in the first row: the element icon and the online state icon, one row down 66 px each step; the part cut from the online picture -->
      <Spot Name="FriendElement" Position="270,73" Pitch="0,66"/>
      <Spot Name="FriendOnline" Position="260,104" Pitch="0,66"/>
      <Spot Name="FriendOnlineArea" Bounds="0,0,32,16"/>
      <!-- the clickable face area of the first row (a click whispers to the friend) -->
      <Spot Name="FriendFaceHit" Bounds="30,65,60,60"/>
      <!-- the page numbers: their right edge x and their y -->
      <Spot Name="FriendPageNumbers" Position="171,400"/>
    </DrawingArea>
