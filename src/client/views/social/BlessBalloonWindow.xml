<?xml version="1.0" encoding="utf-8"?>
<!-- The Bliss Lamp's first form (TBlessBalloonForm, the "bless balloon": a double click on the Bliss Lamp 34325): the name of the player to send best wishes to, typed or picked from
     the friends and guild members that are online (the two ticks filter them; a double click on a row types it), OK goes on to the message form (BlessMessageWindow).  A TSe_Form (it
     is kept on the screen); the view model places it beside the item window.  The game draws a form's controls from the last created to the first: the controls here are in
     drawing order, the reverse of TBlessBalloonForm.Create; DrawControl's balloon picture is under them.  View model: viewmodels/BlessBalloonWindow.cpp. -->
<Panel Name="BlessBalloonLayer" Bounds="0,0,800,600">
  <Window Name="BlessBalloon" AbovePopups="true" Escape="onBlessBalloonClose" Picture="Form_Magnet_1" Position="286,100" Size="228,399" ScreenFit="true" Visible="false">
    <Image Name="BlessBalloonIcon" Picture="Icon_beatify" SourceRect="0,0,76,34" Position="74,11"/>
    <ImageButton Name="BlessBalloonDown" Picture="Btn_ArrowDn_1" Position="192,348" Size="17,17" Click="onBlessBalloonDown"/>
    <ImageButton Name="BlessBalloonUp" Picture="Btn_ArrowUp_1" Position="192,106" Size="17,17" Click="onBlessBalloonUp"/>
    <ImageButton Name="BlessBalloonClose" Picture="Btn_Close_2" Position="113,366" Size="39,20" Hint="[ESC]" Click="onBlessBalloonClose"
                 ClickSound="" ReleaseSound="sound/wav0154.wav"/>
    <ImageButton Name="BlessBalloonCloseSmall" Picture="Btn_Close_s_1" Position="178,26" Size="18,18" Hint="[ESC]" Click="onBlessBalloonClose"
                 ClickSound="" ReleaseSound="sound/wav0154.wav"/>
    <ListBox Name="BlessBalloonNames" Bounds="22,118,163,236" RowHeight="26" FontColor="#FFFFFF" HighlightColor="#89BFF5"
             FocusFrame="false" TextShadow="false" TextOffset="10,3" ScrollBar="BlessBalloonScroll" DoubleClick="onBlessBalloonPick"/>
    <ScrollBar Name="BlessBalloonScroll" Bounds="192,123,17,226" Track="Rail_H5" TrackCap="16" Thumb="bar_H4" ThumbSource="0,0,9,21" ThumbCap="7"/>
    <CheckBox Name="BlessBalloonGuild" Picture="btn_UnCheck_1" CheckedPicture="btn_Check_1" Checked="true" Position="76,89" Size="16,16" Click="onBlessBalloonFilter"/>
    <CheckBox Name="BlessBalloonFriends" Picture="btn_UnCheck_1" CheckedPicture="btn_Check_1" Checked="true" Position="20,89" Size="16,16" Click="onBlessBalloonFilter"/>
    <ImageButton Name="BlessBalloonUse" Picture="Btn_OK_2" Position="68,366" Size="39,20" Hint="Use" Click="onBlessBalloonUse"
                 ClickSound="" ReleaseSound="sound/wav0154.wav"/>
    <TextBox Name="BlessBalloonName" Bounds="96,64,86,20" Skin="Panel26" SkinSource="0,0,104,14" Borders="1,1,1,1" HitTest="true" MaxLength="14"
             AllowPaste="true" FontColor="#080808" Enter="onBlessBalloonUse"/>
  </Window>
</Panel>
