<?xml version="1.0" encoding="utf-8"?>
<!-- The Passion Bouquet's message form (TEnterMsgForm, opened by OK of the love flower's form): the words to send to the player chosen (20 characters), OK sends 23/118.  A TSe_Form (it
     is kept on the screen), at the middle of the screen's top as it is created.  The game draws a form's controls from the last created to the first: the controls here are in
     drawing order, the reverse of TEnterMsgForm.Create.  View model: viewmodels/LoveFlowerMessageWindow.cpp. -->
<Panel Name="LoveFlowerMessageLayer" Bounds="0,0,800,600">
  <Window Name="LoveFlowerMessage" AbovePopups="true" Escape="onLoveFlowerMessageClose" Picture="Form_DupEnterMsg" Position="400,0" Size="262,224" ScreenFit="true" Visible="false">
    <Memo Name="LoveFlowerMessageText" Bounds="22,68,221,56" FontColor="#000000" Effect="Plain" MaxChars="20"/>
    <ImageButton Name="LoveFlowerMessageCloseSmall" Picture="Btn_Close_s_1" Position="212,24" Size="18,18" Click="onLoveFlowerMessageClose" ClickSound=""
                 ReleaseSound="sound/wav0154.wav"/>
    <ImageButton Name="LoveFlowerMessageOk" Picture="Btn_OK_1" Position="60,130" Size="56,20" Click="onLoveFlowerMessageSend"/>
    <ImageButton Name="LoveFlowerMessageCancel" Picture="Btn_Cancel_1" Position="148,130" Size="56,20" Click="onLoveFlowerMessageClose" ClickSound=""
                 ReleaseSound="sound/wav0154.wav"/>
  </Window>
</Panel>
