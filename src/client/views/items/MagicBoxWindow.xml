<?xml version="1.0" encoding="utf-8"?>
<!-- The Rebirth Box's form (TMagicBoxForm, opened by using a Rebirth Box 34198); view model: viewmodels/MagicBoxWindow.cpp.  A piece of gear of the bag that wears the look of
     another piece is dropped on the place (the right button takes it out), OK asks and sends 23/105 option 2.  A TSe_Form (it is kept on the screen); the view model places
     it beside the item window.  The game draws a form's controls from the last created to the first: the controls here are in drawing order, the reverse of
     TMagicBoxForm.Create; DrawControl's box icon is under them. -->
<Panel Name="MagicBoxLayer" Bounds="0,0,800,600">
  <Window Name="MagicBox" Escape="onMagicBoxClose" Picture="Form_Packing" Position="200,100" Size="171,183" ScreenFit="true" Visible="false">
    <Image Name="MagicBoxIcon" Picture="Icon_MagicBox_1" Position="26,4"/>
    <DrawingArea Name="MagicBoxImage" Bounds="70,71,30,30" HitTest="true" RightMouseUp="onMagicBoxTake">
      <!-- the stack count text: top-left in the icon, colour in RGB565 2113 -->
      <Spot Name="MagicBoxCount" Position="2,20" Color="#080808"/>
    </DrawingArea>
    <ImageButton Name="MagicBoxOk" Picture="Btn_OK_2" Position="38,142" Size="39,20" Click="onMagicBoxOk" ClickSound="" ReleaseSound="sound/wav0154.wav"/>
    <ImageButton Name="MagicBoxCancel" Picture="Btn_Cancel_3" Position="93,142" Size="39,20" Hint="[ESC]" Click="onMagicBoxClose" ClickSound=""
                 ReleaseSound="sound/wav0154.wav"/>
  </Window>
</Panel>
